{
  "buildCommand": "pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/flowpay run build",
  "outputDirectory": "artifacts/flowpay/dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[...path].js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
