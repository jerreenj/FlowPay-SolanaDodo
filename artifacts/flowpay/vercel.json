{
  "buildCommand": "pnpm --filter @workspace/flowpay run build",
  "outputDirectory": "artifacts/flowpay/dist",
  "installCommand": "pnpm install",
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://Flowpay-Solana.replit.app/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
